--- !u!114 &6290758123881146467
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5591583738181444348}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a64d59875f8ad3f40b0c27ad33578d30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemNameText: {fileID: 8250568282447876490}
  descriptionText: {fileID: 2382196672995015330}
  defaultEntryIndex: 11
  entries:
  - target: {fileID: 786006718862373497}
    itemName: Screen Resolution
    description: Changes the number of pixels displayed on screen. Higher resolutions
      look sharper but may reduce performance.
  - target: {fileID: 4643228762906825231}
    itemName: Frame Rate
    description: Sets the maximum frame rate. Higher values make motion smoother
      but use more processing power.
  - target: {fileID: 4374191685490591686}
    itemName: Display Mode
    description: Chooses between Full Screen, Borderless, and Windowed display modes.
  - target: {fileID: 575147933492891257}
    itemName: Sharpening
    description: Improves image clarity and edge detail. FidelityFX may make the
      picture look sharper.
  - target: {fileID: 262185248088135326}
    itemName: Vertical Synchronisation
    description: Synchronizes the frame rate with the monitor refresh rate to reduce
      screen tearing.
  - target: {fileID: 4277993157260693325}
    itemName: Motion Blur
    description: Adds blur during fast camera or object movement for a smoother cinematic
      effect.
  - target: {fileID: 5896422737419190283}
    itemName: Chromatic Aberration
    description: Adds subtle color separation near screen edges as a visual effect.
  - target: {fileID: 4238821964882257790}
    itemName: Brightness
    description: Adjusts the overall brightness of the image.
  - target: {fileID: 6079954594384672718}
    itemName: Contrast
    description: Adjusts the difference between the darkest and brightest parts of
      the image.
  - target: {fileID: 5119787451459133036}
    itemName: Saturation
    description: Adjusts the intensity of colors. Lower values look faded; higher
      values look more vivid.
  - target: {fileID: 4210738841216506082}
    itemName: Field Of View
    description: Changes how much of the world the camera can see. A wider view shows
      more but may distort the edges.
