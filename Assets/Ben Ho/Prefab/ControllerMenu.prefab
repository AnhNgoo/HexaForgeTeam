--- !u!114 &6920971443037315661
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8122208366918396515}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a64d59875f8ad3f40b0c27ad33578d30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemNameText: {fileID: 306768976176932684}
  descriptionText: {fileID: 118907560577673970}
  defaultEntryIndex: 14
  entries:
  - target: {fileID: 7457371819868253443}
    itemName: Control Type
    description: Selects the preferred input method between Keyboard and Mouse and
      Controller.
  - target: {fileID: 3972916837068986670}
    itemName: Horizontal Sensitivity
    description: Adjusts how quickly the camera turns left and right.
  - target: {fileID: 2218447928256611356}
    itemName: Vertical Sensitivity
    description: Adjusts how quickly the camera looks up and down.
  - target: {fileID: 6338600933072866639}
    itemName: Vibration
    description: Enables or disables controller vibration and haptic feedback.
  - target: {fileID: 6309908059568589945}
    itemName: Aim Assist
    description: Enables or disables assistance when aiming at a target.
  - target: {fileID: 8229373333173975578}
    itemName: Move Forward
    description: Sets the key used to move the character forward.
  - target: {fileID: 9057445078308684815}
    itemName: Move Backward
    description: Sets the key used to move the character backward.
  - target: {fileID: 6601155871324442814}
    itemName: Move Left
    description: Sets the key used to move the character to the left.
  - target: {fileID: 2465265122359760851}
    itemName: Move Right
    description: Sets the key used to move the character to the right.
  - target: {fileID: 111835202357754673}
    itemName: Sprint
    description: Sets the key used to run or sprint.
  - target: {fileID: 8282291323849317068}
    itemName: Dodge
    description: Sets the key used to dodge or roll away from attacks.
  - target: {fileID: 2303847262912885641}
    itemName: Jump
    description: Sets the key used to make the character jump.
  - target: {fileID: 229567888037492244}
    itemName: Interact
    description: Sets the key used to interact with objects, characters, and menus.
  - target: {fileID: 6210574225698813022}
    itemName: Sneak / Crouch
    description: Sets the key used to crouch or move quietly.
