  defaultEntryIndex: 6
  entries:
  - target: {fileID: 1072994658184051171}
    itemName: Master Volume
    description: Controls the overall volume of all game audio.
  - target: {fileID: 4677714918800692674}
    itemName: Music Volume
    description: Controls the volume of background music without affecting dialogue
      or sound effects.
  - target: {fileID: 2518222112211842829}
    itemName: Sound Effects Volume
    description: Controls gameplay sound effects such as attacks, impacts, enemies,
      and interface sounds.
  - target: {fileID: 7246400451108554217}
    itemName: Dialogue Volume
    description: Controls the volume of spoken dialogue and character voice lines.
  - target: {fileID: 1106540463051995365}
    itemName: Background Sound
    description: Enables or disables background music.
  - target: {fileID: 7799048852194292613}
    itemName: Collision Sound
    description: Enables or disables collision and impact sounds.
