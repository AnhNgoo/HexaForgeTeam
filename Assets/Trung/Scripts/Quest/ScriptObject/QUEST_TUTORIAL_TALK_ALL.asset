  targetProgress: 6
  npcName: Guide
  notStartedDialogues:
  - speaker: 0
    text: Greetings, newcomer! Welcome to our sanctuary. You look a bit disoriented.
  - speaker: 1
    text: I just arrived here. Could you show me around or tell me who to meet?
  - speaker: 0
    text: Take your time to explore the base first. Go introduce yourself to the
      other 6 companions around here.
  inProgressDialogues:
  - speaker: 0
    text: Have you met everyone yet? There are still people waiting to get acquainted
      with you."
  - speaker: 1
    text: I'm on my way to talk to them right now.
  canClaimDialogues:
  - speaker: 1
    text: I've met everyone in the base. They seem quite helpful!
  completedDialogues:
  - speaker: 0
    text: Splendid! Knowing your allies is the first step before venturing into danger.
      Here is a small welcome gift for you.
