  questID: QUEST_ROLL_1
  questTitle: Awaken the Relic
  questDescription: Perform a Rune Summon at Tran Nam Long's station to obtain your
    first power.
  questType: 0
  requiredAccountLevel: 1
  requiredPrerequisiteQuestID: QUEST_TUTORIAL_TALK_ALL
  targetProgress: 1
  targetStationPointName: 
  npcName: Tran Nam Long
  notStartedDialogues:
  - speaker: 0
    text: Ah, the new face! I manage our ancient relics and mysterious supply boxes.
  - speaker: 1
    text: How do these relics work?
  - speaker: 0
    text: Channel your energy to summon one. Go ahead, perform your first summon
      right here!
  inProgressDialogues:
  - speaker: 0
    text: What are you waiting for? Open the Gacha menu and awaken your first relic!
  - speaker: 0
    text: Let me try it right now.
  canClaimDialogues:
  - speaker: 1
    text: The resonance worked! I've summoned a new relic.
  - speaker: 0
    text: Impressive resonance! Equip it well to strengthen your battle prowess.
      Here is your reward.
  completedDialogues:
  - speaker: 0
    text: Feel free to summon more whenever you have enough Tickets or Gems.
  rewardGem: 200
  rewardShard: 20
  rewardExp: 150
  rewardItems:
  - itemID: GACHA_TICKET_01
    amount: 10
