  npcName: Trung
  notStartedDialogues:
  - speaker: 0
    text: I see you've survived your first expedition! It's time to track your heroic
      milestones.
  - speaker: 1
    text: Where can I see what milestones I've achieved?
  - speaker: 0
    text: Open the Achievement panel from my menu to claim your milestone rewards.
  inProgressDialogues:
  - speaker: 0
    text: Check the Achievement list to see what feats you have accomplished.
  canClaimDialogues:
  - speaker: 0
    text: I've checked the achievements. There are many goals to pursue!
  - speaker: 0
    text: Keep completing them as you venture deeper. Here is your reward for this
      milestone.
  completedDialogues:
  - speaker: 0
    text: Check back often to claim more achievement rewards as you progress.
  rewardGem: 60
  rewardShard: 40
  rewardExp: 100
