    m_Localized: Master Volume
    m_Metadata:
      m_Items: []
  - m_Id: 2766927852314624
    m_Localized: Controls the overall volume of all game audio.
    m_Metadata:
      m_Items: []
  - m_Id: 2766993166016512
    m_Localized: 'Music Volume

'
    m_Metadata:
      m_Items: []
  - m_Id: 2767041962549248
    m_Localized: "Controls the volume of background music without affecting dialogue
      or sound effects.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 2767044097449984
    m_Localized: 'Sound Effects Volume

'
    m_Metadata:
      m_Items: []
  - m_Id: 2767045364129792
    m_Localized: 'Controls gameplay sound effects such as attacks, impacts, enemies,
      and interface sounds.

'
    m_Metadata:
      m_Items: []
  - m_Id: 2767046869884928
    m_Localized: 'Dialogue Volume

'
    m_Metadata:
      m_Items: []
  - m_Id: 2767048958648320
    m_Localized: 'Controls the volume of spoken dialogue and character voice lines.

'
    m_Metadata:
      m_Items: []
  - m_Id: 2767378974875648
    m_Localized: 'Background Sound

'
    m_Metadata:
      m_Items: []
  - m_Id: 2767381315297280
    m_Localized: 'Enables or disables background music.

'
    m_Metadata:
      m_Items: []
  - m_Id: 2767382695223296
    m_Localized: 'Collision Sound

'
    m_Metadata:
      m_Items: []
  - m_Id: 2767384121286656
    m_Localized: 'Enables or disables collision and impact sounds.

'
