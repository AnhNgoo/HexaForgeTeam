      m_Items: []
  - m_Id: 6077127763636224
    m_Localized: "M\u1ED9t c\xE2y tr\u01B0\u1EE3ng t\u1EA7m xa c\u01A1 b\u1EA3n."
    m_Metadata:
      m_Items: []
  - m_Id: 6077308450058240
    m_Localized: "Huy\u1EBFt Ph\u1EE7"
    m_Metadata:
      m_Items: []
  - m_Id: 6077312812134400
    m_Localized: "M\u1ED9t chi\u1EBFn ph\u1EE7 nhu\u1ED1m s\u1EAFc \u0111\u1ECF th\u1EABm,
      nh\u01B0 th\u1EC3 v\u1EABn c\xF2n l\u01B0u gi\u1EEF m\xE1u c\u1EE7a nh\u1EEFng
      k\u1EBB t\u1EEBng ng\xE3 xu\u1ED1ng d\u01B0\u1EDBi l\u01B0\u1EE1i r\xECu. M\u1ED7i
      nh\xE1t ch\xE9m \u0111\u1EC1u mang theo c\u01A1n kh\xE1t chi\u1EBFn \u0111\u1EA5u
      kh\xF4ng bao gi\u1EDD l\u1EAFng d\u1ECBu."
    m_Metadata:
      m_Items: []
  - m_Id: 6077456357994496
    m_Localized: "Ki\u1EBFm Zorya"
    m_Metadata:
      m_Items: []
  - m_Id: 6077457129746432
    m_Localized: "M\u1ED9t thanh ki\u1EBFm t\u1ECFa \xE1nh s\xE1ng d\u1ECBu nh\u1EB9
      nh\u01B0 b\xECnh minh v\u1EEBa l\xF3 d\u1EA1ng. L\u01B0\u1EE1i ki\u1EBFm c\u1EE7a
      Zorya x\xE9 tan b\xF3ng t\u1ED1i, d\u1EABn l\u1ED1i cho ng\u01B0\u1EDDi s\u1EED
      d\u1EE5ng gi\u1EEFa chi\u1EBFn tr\u01B0\u1EDDng h\u1ED7n lo\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6077607180972032
    m_Localized: "Tr\u01B0\u1EE3ng Caelen"
    m_Metadata:
      m_Items: []
  - m_Id: 6077608489594880
    m_Localized: "M\u1ED9t c\xE2y tr\u01B0\u1EE3ng l\u01B0u gi\u1EEF lu\u1ED3ng ma
      l\u1EF1c xanh th\u1EB3m, kh\u1EBD dao \u0111\u1ED9ng theo t\u1EEBng nh\u1ECBp
      th\u1EDF c\u1EE7a ng\u01B0\u1EDDi s\u1EED d\u1EE5ng. Khi \u0111\u01B0\u1EE3c
      gi\u1EA3i ph\xF3ng, s\u1EE9c m\u1EA1nh c\u1EE7a Caelen lao xuy\xEAn chi\u1EBFn
      tr\u01B0\u1EDDng nh\u01B0 m\u1ED9t v\xEC sao r\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 6170837564669952
    m_Localized: "Tr\u01B0\u1EE3ng Pyren"
    m_Metadata:
      m_Items: []
  - m_Id: 6171204448829440
    m_Localized: "M\u1ED9t c\xE2y tr\u01B0\u1EE3ng ch\u1EE9a ng\u1ECDn l\u1EEDa r\u1EF1c
      ch\xE1y kh\xF4ng bao gi\u1EDD t\u1EAFt. M\u1ED7i l\u1EA7n vung tr\u01B0\u1EE3ng,
      ma l\u1EF1c c\u1EE7a Pyren b\xF9ng l\xEAn d\u1EEF d\u1ED9i, thi\xEAu r\u1EE5i
      m\u1ECDi k\u1EBB c\u1EA3n \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 6171734256533504
    m_Localized: "\u0110\u1EA1i Ki\u1EBFm Aetherion"
    m_Metadata:
      m_Items: []
  - m_Id: 6172098565390336
    m_Localized: "M\u1ED9t \u0111\u1EA1i ki\u1EBFm huy\u1EC1n tho\u1EA1i \u0111\u01B0\u1EE3c
      t\xF4i luy\u1EC7n t\u1EEB tinh hoa c\u1EE7a t\u1EA7ng tr\u1EDDi. T\u01B0\u01A1ng
      truy\u1EC1n r\u1EB1ng khi Aetherion th\u1EE9c t\u1EC9nh, m\u1ED7i nh\xE1t ch\xE9m
      s\u1EBD x\xE9 to\u1EA1c m\xE0n \u0111\xEAm v\xE0 khi\u1EBFn c\u1EA3 chi\u1EBFn
      tr\u01B0\u1EDDng ph\u1EA3i c\xFAi m\xECnh tr\u01B0\u1EDBc \xE1nh s\xE1ng thi\xEAn
      gi\u1EDBi."
    m_Metadata:
      m_Items: []
  - m_Id: 6172410340589568
    m_Localized: "Th\xE1nh Th\u01B0\u01A1ng Seraphine"
    m_Metadata:
      m_Items: []
  - m_Id: 6172413838639104
    m_Localized: "Ng\u1ECDn th\xE1nh th\u01B0\u01A1ng mang \xE1nh s\xE1ng c\u1EE7a
      Seraphine, \u0111\u01B0\u1EE3c ban ph\u01B0\u1EDBc \u0111\u1EC3 xuy\xEAn th\u1EE7ng
      m\u1ECDi b\xF3ng t\u1ED1i. Khi m\u0169i th\u01B0\u01A1ng r\u1EF1c s\xE1ng,
      ph\xE1n quy\u1EBFt t\u1EEB thi\xEAn gi\u1EDBi s\u1EBD gi\xE1ng xu\u1ED1ng nh\u1EEFng
      k\u1EBB d\xE1m c\u1EA3n \u0111\u01B0\u1EDDng ng\u01B0\u1EDDi s\u1EED d\u1EE5ng
      n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 6172808119992320
    m_Localized: "V\u01B0\u01A1ng Tr\u01B0\u1EE3ng Aurethia"
    m_Metadata:
      m_Items: []
  - m_Id: 6172821776646144
    m_Localized: "V\u01B0\u01A1ng tr\u01B0\u1EE3ng huy\u1EC1n tho\u1EA1i t\u1EEBng
      thu\u1ED9c v\u1EC1 Aurethia, n\u1EEF ho\xE0ng c\u1EE7a \xE1nh b\xECnh minh.
      \xC1nh s\xE1ng k\u1EBFt t\u1EE5 n\u01A1i \u0111\u1EC9nh tr\u01B0\u1EE3ng c\xF3
      th\u1EC3 xua tan m\xE0n \u0111\xEAm v\xE0 gi\xE1ng xu\u1ED1ng chi\u1EBFn tr\u01B0\u1EDDng
      quy\u1EC1n uy r\u1EF1c r\u1EE1 c\u1EE7a m\u1EB7t tr\u1EDDi."
    m_Metadata:
      m_Items: []
  - m_Id: 6173225910419456
    m_Localized: "Quy\u1EC1n Tr\u01B0\u1EE3ng Vesperith"
    m_Metadata:
      m_Items: []
  - m_Id: 6173228938706944
    m_Localized: "Quy\u1EC1n tr\u01B0\u1EE3ng huy\u1EC1n tho\u1EA1i \u0111\u01B0\u1EE3c
      sinh ra n\u01A1i ho\xE0ng h\xF4n giao h\xF2a c\xF9ng v\u1EF1c th\u1EB3m. M\u1ED7i
      ph\xE9p thu\u1EADt c\u1EE7a Vesperith \u0111\u1EC1u ph\u1EE7 b\xF3ng \u0111\xEAm
      l\xEAn chi\u1EBFn tr\u01B0\u1EDDng, r\xFAt c\u1EA1n \xE1nh s\xE1ng v\xE0 nh\u1EA5n
      ch\xECm k\u1EBB th\xF9 trong m\xE0n \u0111\xEAm v\u0129nh c\u1EEDu."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
