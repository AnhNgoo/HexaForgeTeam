  m_TableData:
  - m_Id: 82850193408
    m_Localized: "Ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 367878316032
    m_Localized: "C\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 370508144640
    m_Localized: "Ng\xF4n ng\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 382248001536
    m_Localized: "X\xE1c nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 583369072640
    m_Localized: "H\u1EE7y"
    m_Metadata:
      m_Items: []
  - m_Id: 585290063872
    m_Localized: "Quay l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 586858733568
    m_Localized: "\u0110ang t\u1EA3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 730471702528
    m_Localized: "Nh\xE2n v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 412793937436672
    m_Localized: "\u0110\u0103ng xu\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 2763451600576512
    m_Localized: "\xC2m l\u01B0\u1EE3ng t\u1ED5ng\r"
    m_Metadata:
      m_Items: []
  - m_Id: 2766927852314624
    m_Localized: "\u0110i\u1EC1u khi\u1EC3n \xE2m l\u01B0\u1EE3ng t\u1ED5ng th\u1EC3
      c\u1EE7a to\xE0n b\u1ED9 \xE2m thanh trong game."
    m_Metadata:
      m_Items: []
  - m_Id: 2766993166016512
    m_Localized: "\xC2m l\u01B0\u1EE3ng nh\u1EA1c\r"
    m_Metadata:
      m_Items: []
  - m_Id: 2767041962549248
    m_Localized: "\u0110i\u1EC1u khi\u1EC3n \xE2m l\u01B0\u1EE3ng nh\u1EA1c n\u1EC1n
      m\xE0 kh\xF4ng \u1EA3nh h\u01B0\u1EDFng \u0111\u1EBFn h\u1ED9i tho\u1EA1i hay
      hi\u1EC7u \u1EE9ng \xE2m thanh.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 2767044097449984
    m_Localized: "\xC2m l\u01B0\u1EE3ng hi\u1EC7u \u1EE9ng\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 2767045364129792
    m_Localized: "\u0110i\u1EC1u khi\u1EC3n c\xE1c hi\u1EC7u \u1EE9ng \xE2m thanh
      trong game nh\u01B0 t\u1EA5n c\xF4ng, va ch\u1EA1m, k\u1EBB \u0111\u1ECBch
      v\xE0 \xE2m thanh giao di\u1EC7n.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 2767046869884928
    m_Localized: "\xC2m l\u01B0\u1EE3ng h\u1ED9i tho\u1EA1i\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 2767048958648320
    m_Localized: "\u0110i\u1EC1u khi\u1EC3n \xE2m l\u01B0\u1EE3ng l\u1EDDi tho\u1EA1i
      v\xE0 gi\u1ECDng n\xF3i c\u1EE7a nh\xE2n v\u1EADt.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 2767378974875648
    m_Localized: "\xC2m thanh n\u1EC1n\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 2767381315297280
    m_Localized: "B\u1EADt ho\u1EB7c t\u1EAFt nh\u1EA1c n\u1EC1n.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 2767382695223296
    m_Localized: "\xC2m thanh va ch\u1EA1m\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 2767384121286656
    m_Localized: "B\u1EADt ho\u1EB7c t\u1EAFt \xE2m thanh va ch\u1EA1m v\xE0 t\xE1c
      \u0111\u1ED9ng.\r\n"
  - m_Id: 5717089735880704
    m_Localized: "V\u0169 Kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 5717179552706560
    m_Localized: "Sinh L\u1EF1c T\u1ED1i \u0110a"
    m_Metadata:
      m_Items: []
  - m_Id: 5717313871097856
    m_Localized: "S\xE1t Th\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 5717337153679360
    m_Localized: "Ph\xF2ng Th\u1EE7"
    m_Metadata:
      m_Items: []
  - m_Id: 5717357789655040
    m_Localized: "Th\u1EC3 L\u1EF1c"
    m_Metadata:
      m_Items: []
  - m_Id: 5717378157195264
    m_Localized: "T\u1ED1c \u0110\u1ED9 Ch\u1EA1y"
    m_Metadata:
      m_Items: []
  - m_Id: 5717401343307776
    m_Localized: "N\u0103ng L\u01B0\u1EE3ng T\u1ED1i \u0110a"
    m_Metadata:
      m_Items: []
  - m_Id: 5717436005036032
    m_Localized: "S\xE1t Th\u01B0\u01A1ng \u0110\u1ED9c"
    m_Metadata:
      m_Items: []
  - m_Id: 5717452748697600
