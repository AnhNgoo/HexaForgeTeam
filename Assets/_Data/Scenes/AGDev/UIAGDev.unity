--- !u!114 &1655394034
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1655394012}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a64d59875f8ad3f40b0c27ad33578d30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemNameText: {fileID: 1655393997}
  descriptionText: {fileID: 1655393996}
  defaultEntryIndex: 14
  entries:
  - target: {fileID: 1655394007}
    itemName: Control Type
    description: Selects the preferred input method between Keyboard and Mouse and
      Controller.
  - target: {fileID: 1655394011}
    itemName: Horizontal Sensitivity
    description: Adjusts how quickly the camera turns left and right.
  - target: {fileID: 1655394010}
    itemName: Vertical Sensitivity
    description: Adjusts how quickly the camera looks up and down.
  - target: {fileID: 1655394008}
    itemName: Vibration
    description: Enables or disables controller vibration and haptic feedback.
  - target: {fileID: 1655394009}
    itemName: Aim Assist
    description: Enables or disables assistance when aiming at a target.
  - target: {fileID: 1655394001}
    itemName: Move Forward
    description: Sets the key used to move the character forward.
  - target: {fileID: 1655394000}
    itemName: Move Backward
    description: Sets the key used to move the character backward.
  - target: {fileID: 1655393998}
    itemName: Move Left
    description: Sets the key used to move the character to the left.
  - target: {fileID: 1655393999}
    itemName: Move Right
    description: Sets the key used to move the character to the right.
  - target: {fileID: 1655394004}
    itemName: Sprint
    description: Sets the key used to run or sprint.
  - target: {fileID: 1655394005}
    itemName: Dodge
    description: Sets the key used to dodge or roll away from attacks.
  - target: {fileID: 1655394006}
    itemName: Jump
    description: Sets the key used to make the character jump.
  - target: {fileID: 1655394002}
    itemName: Interact
    description: Sets the key used to interact with objects, characters, and menus.
  - target: {fileID: 1655394003}
    itemName: Sneak / Crouch
    description: Sets the key used to crouch or move quietly.
--- !u!114 &1655394035
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1655394026}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a64d59875f8ad3f40b0c27ad33578d30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemNameText: {fileID: 1655394014}
  descriptionText: {fileID: 1655394013}
  defaultEntryIndex: 11
  entries:
  - target: {fileID: 1655394025}
    itemName: Screen Resolution
    description: Changes the number of pixels displayed on screen. Higher resolutions
      look sharper but may reduce performance.
  - target: {fileID: 1655394024}
    itemName: Frame Rate
    description: Sets the maximum frame rate. Higher values make motion smoother
      but use more processing power.
  - target: {fileID: 1655394023}
    itemName: Display Mode
    description: Chooses between Full Screen, Borderless, and Windowed display modes.
  - target: {fileID: 1655394019}
    itemName: Sharpening
    description: Improves image clarity and edge detail. FidelityFX may make the
      picture look sharper.
  - target: {fileID: 1655394022}
    itemName: Vertical Synchronisation
    description: Synchronizes the frame rate with the monitor refresh rate to reduce
      screen tearing.
  - target: {fileID: 1655394021}
    itemName: Motion Blur
    description: Adds blur during fast camera or object movement for a smoother cinematic
      effect.
  - target: {fileID: 1655394020}
    itemName: Chromatic Aberration
    description: Adds subtle color separation near screen edges as a visual effect.
  - target: {fileID: 1655394018}
    itemName: Brightness
    description: Adjusts the overall brightness of the image.
  - target: {fileID: 1655394017}
    itemName: Contrast
    description: Adjusts the difference between the darkest and brightest parts of
      the image.
  - target: {fileID: 1655394016}
    itemName: Saturation
    description: Adjusts the intensity of colors. Lower values look faded; higher
      values look more vivid.
  - target: {fileID: 1655394015}
    itemName: Field Of View
    description: Changes how much of the world the camera can see. A wider view shows
      more but may distort the edges.
